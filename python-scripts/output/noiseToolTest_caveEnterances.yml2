type: EXPRESSION
expression: test(x*2, y*2, z*2)
samplers:
   test:
      dimensions: 3
      type: EXPRESSION
      expression: |-
        min(
          0.37 + cave_entrance(x*.75, y*.5, z*.75) +
          yClampedGradient(y, -10, 30, 0.3, 0),
          spaghetti_roughness_function(x, y, z) +
          clamp(-1, 1,
            max(
              spaghetti_3d_1_rarity(x, y, z),
              spaghetti_3d_2_rarity(x, y, z)
            ) +
            -0.0765 + -0.011499999999999996 * spaghetti_3d_thickness(x, y, z)
          )
        )
      functions:
        clamp:
          arguments:
          - minNum
          - maxNum
          - input
          expression: min(maxNum, max(minNum, input))
        yClampedGradient:
          arguments:
            - y
            - fromY
            - toY
            - fromValue
            - toValue
          expression: min(max((y - fromY) / (toY - fromY), 0), 1) * (toValue - fromValue) + fromValue
      samplers:
        spaghetti_roughness_function:
          dimensions: 3
          type: EXPRESSION
          expression: |-
            (-0.05 + -0.05 * spaghetti_roughness_modulator(x, y, z)) *
            (-0.4 + abs(spaghetti_roughness(x, y, z)))
          samplers:
            spaghetti_roughness:
              dimensions: 3
              expression: (1.15 * noise0(x, y, z))
              samplers:
                noise0:
                  dimensions: 3
                  frequency: 0.0078125
                  type: OPEN_SIMPLEX_2
              type: EXPRESSION
            spaghetti_roughness_modulator:
              dimensions: 3
              expression: (1.15 * noise0(x, y, z))
              samplers:
                noise0:
                  dimensions: 3
                  frequency: 0.0009765625
                  type: OPEN_SIMPLEX_2
              type: EXPRESSION
        spaghetti_3d_1_rarity:
          dimensions: 3
          type: EXPRESSION
          expression: |-
            rarity(spaghetti_3d_rarity(x*2, y, z*2)) *
              abs(spaghetti_3d_1(x / rarity(spaghetti_3d_rarity(x*2, y, z*2)),
              y / rarity(spaghetti_3d_rarity(x*2, y, z*2)),
              z / rarity(spaghetti_3d_rarity(x*2, y, z*2))))
          functions:
            rarity:
              arguments:
              - input
              expression: if(input < -0.5, 0.75, if(input < 0, 1, if (input < 0.5, 1.5, 2)))
          samplers:
            spaghetti_3d_1:
              dimensions: 3
              expression: (1.15 * noise0(x, y, z))
              samplers:
                noise0:
                  dimensions: 3
                  frequency: 0.001953125
                  type: OPEN_SIMPLEX_2
              type: EXPRESSION
            spaghetti_3d_rarity:
              dimensions: 3
              expression: (1.15 * noise0(x, y, z))
              samplers:
                noise0:
                  dimensions: 3
                  frequency: 0.0001220703125
                  type: OPEN_SIMPLEX_2
              type: EXPRESSION
        spaghetti_3d_2_rarity:
          dimensions: 3
          type: EXPRESSION
          expression: |-
            rarity(spaghetti_3d_rarity(x*2, y, z*2)) *
              abs(spaghetti_3d_2(x / rarity(spaghetti_3d_rarity(x*2, y, z*2)),
              y / rarity(spaghetti_3d_rarity(x*2, y, z*2)),
              z / rarity(spaghetti_3d_rarity(x*2, y, z*2))))
          functions:
            rarity:
              arguments:
              - input
              expression: if(input < -0.5, 0.75, if(input < 0, 1, if (input < 0.5, 1.5, 2)))
          samplers:
            spaghetti_3d_2:
              dimensions: 3
              expression: (1.15 * noise0(x, y, z))
              samplers:
                noise0:
                  dimensions: 3
                  frequency: 0.001953125
                  type: OPEN_SIMPLEX_2
              type: EXPRESSION
            spaghetti_3d_rarity:
              dimensions: 3
              expression: (1.15 * noise0(x, y, z))
              samplers:
                noise0:
                  dimensions: 3
                  frequency: 0.0001220703125
                  type: OPEN_SIMPLEX_2
              type: EXPRESSION
        cave_entrance:
          dimensions: 3
          expression: (0.26285714285714284 * noise0(x, y, z) + 0.16428571428571428 * noise1(x,
            y, z) + 0.16428571428571428 * noise2(x, y, z))
          samplers:
            noise0:
              dimensions: 3
              frequency: 0.001953125
              type: OPEN_SIMPLEX_2
            noise1:
              dimensions: 3
              frequency: 0.00390625
              type: OPEN_SIMPLEX_2
            noise2:
              dimensions: 3
              frequency: 0.0078125
              type: OPEN_SIMPLEX_2
          type: EXPRESSION
        spaghetti_3d_thickness:
          dimensions: 3
          expression: (1.15 * noise0(x, y, z))
          samplers:
            noise0:
              dimensions: 3
              frequency: 0.0009765625
              type: OPEN_SIMPLEX_2
          type: EXPRESSION
