sampler:
  dimensions: 3
  expression: sampling(mainNoise(x,y,z), minNoise(x,y,z), maxNoise(x,y,z))
  functions:
    sampling:
      arguments:
      - main
      - min
      - max
      expression: |-
        if(main * 6.4 + 0.5 <= 0,
        clampLerp(min, 0, main),
        if(main * 6.4 + 0.5 >= 1,
        clampLerp(0, max, main),
        clampLerp(min, max, main)))
      functions:
        clampLerp:
          arguments:
          - a
          - b
          - t
          expression: if(t<=0,a,if(t>=0.0078125,b,a*(t-0.0078125)/(-0.0078125)+b*t/0.0078125))
  samplers:
    mainNoise:
      dimensions: 3
      expression: 1.15 * noise(x * factoredXZ, smear(y * factoredY, factoredSmear),
        z * factoredXZ)
      functions: &id001
        smear:
          arguments:
          - y
          - yScale
          expression: |
            floor(y / yScale + 1e-7) * yScale
      samplers:
        noise:
          dimensions: 3
          gain: 2
          lacunarity: 0.5
          octaves: 4
          sampler:
            dimensions: 3
            frequency: 0.03125
            type: OPEN_SIMPLEX_2
          type: FBM
      type: EXPRESSION
      variables: &id002
        factoredSmear: 4.277575000000001
        factoredXZ: 2.1387875000000003
        factoredY: 0.5346968750000001
        scaledSmear: 684.412
        scaledXZ: 171.103
        scaledY: 85.5515
    maxNoise:
      dimensions: 3
      expression: 0.575 * noise(x * scaledXZ, smear(y * scaledY, scaledSmear), z *
        scaledXZ)
      functions: *id001
      samplers:
        noise:
          dimensions: 3
          gain: 2
          lacunarity: 0.5
          octaves: 8
          sampler:
            frequency: 0.001953125
            salt: 1
            type: OPEN_SIMPLEX_2
          type: FBM
      type: EXPRESSION
      variables: *id002
    minNoise:
      dimensions: 3
      expression: 0.575 * noise(x * scaledXZ, smear(y * scaledY, scaledSmear), z *
        scaledXZ)
      functions: *id001
      samplers:
        noise:
          dimensions: 3
          gain: 2
          lacunarity: 0.5
          octaves: 8
          sampler:
            frequency: 0.001953125
            type: OPEN_SIMPLEX_2
          type: FBM
      type: EXPRESSION
      variables: *id002
  type: EXPRESSION
  variables: *id002
